<template>
    <MainMenu>
        <fragment slot="title"><label class="title">{ args.Title }</label></fragment>
        <button class="primary" onClick={ choose }>Play</button>
    </MainMenu>
</template>

<script setup lang="go">
import "strings"

type MenuProps struct {
	Title string
	Select func()
}

func setup(args MenuProps) {
	choose := func() {
		_ = strings.TrimSpace(args.Title)
		args.Select()
	}
}
</script>

<style>
$accent: theme.colors.accent

.title
  color: $accent
  font-size: theme.typography.title

.primary
  width: 100%
  background: theme.colors.primary
  color: theme.colors.text
  &:hover
    background: theme.colors.primary-hover
</style>
