{
  "Component": {
    "prefix": "kartui",
    "body": [
      "<script setup lang=\"go\">",
      "type ${1:Menu}Props struct {",
      "    Title string",
      "    Close func()",
      "}",
      "",
      "func setup(props ${1}Props) {}",
      "</script>",
      "",
      "<template>",
      "  <panel modal=\"true\" class=\"screen\">",
      "    <label>{props.Title}</label>",
      "    <button onClick={props.Close}>Close</button>",
      "  </panel>",
      "</template>",
      "",
      "<style>",
      ".screen",
      "  width: 80%",
      "  padding: 16px",
      "  gap: 8px",
      "  align: stretch",
      "</style>",
      "$0"
    ],
    "description": "SFC component with typed props and indented styles"
  },
  "Style rule": {
    "prefix": "style",
    "body": [
      ".${1:class}",
      "  ${2:color}: theme.colors.${3:text}"
    ],
    "description": "Insert a local rule inside an existing indented style block"
  },
  "Text alignment": {
    "prefix": "text-align",
    "body": [
      "text-align: ${1|left,center,right|}"
    ],
    "description": "Align label or control text"
  },
  "Font family": {
    "prefix": "font-family",
    "body": [
      "font-family: theme.typography.${1|body,title,mono|}-family"
    ],
    "description": "Select a theme typography role"
  },
  "Layout": {
    "prefix": "layout",
    "body": [
      "<template>",
      "  <panel modal=\"true\" class=\"screen\">",
      "    <slot name=\"title\"/>",
      "    <panel class=\"content\"><slot/></panel>",
      "  </panel>",
      "</template>",
      "",
      "<style>",
      ".screen",
      "  padding: 16px",
      "  gap: 8px",
      ".content",
      "  align: stretch",
      "</style>"
    ],
    "description": "SFC layout with named/default slots and local styles; its filename supplies the name"
  },
  "Layout view": {
    "prefix": "layout-view",
    "body": [
      "<${1:WindowLayout}>",
      "    <fragment slot=\"title\"><label>${2:Title}</label></fragment>",
      "    $0",
      "</${1}>"
    ],
    "description": "Project view content into a KartUI layout"
  },
  "Horizontal panel": {
    "prefix": "panel-row",
    "body": [
      "<panel class=\"${1:row}\">",
      "  $0",
      "</panel>"
    ],
    "description": "Insert a panel; add direction: row to its class rule"
  },
  "Scrollable panel": {
    "prefix": "panel-scroll",
    "body": [
      "<panel class=\"${1:scrollable}\">",
      "  $0",
      "</panel>"
    ],
    "description": "Insert a panel; add a bounded height and overflow: scroll to its class rule"
  },
  "Conditional markup": {
    "prefix": "if-ui",
    "body": [
      "if ${1:condition} {",
      "    ${2:<label>Visible</label>}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Render one of two retained KartUI branches"
  },
  "View transition": {
    "prefix": "transition-view",
    "body": [
      "transition-duration: ${1:180}"
    ],
    "description": "Fade a root view in using host draw-time interpolation"
  },
  "Transition timing": {
    "prefix": "transition-timing",
    "body": [
      "transition-duration: ${1:180}",
      "transition-delay: ${2:0}",
      "transition-easing: ${3|ease-out,ease-in-out,linear|}"
    ],
    "description": "Configure bounded host draw-time transition timing"
  },
  "Overlay panel": {
    "prefix": "panel-overlay",
    "body": [
      "<panel class=\"${1:overlay}\">",
      "  $0",
      "</panel>"
    ],
    "description": "Insert a panel; add position: absolute and insets to its class rule"
  },
  "Semantic back": {
    "prefix": "on-back",
    "body": [
      "onBack={ ${1:props.Back} }"
    ],
    "description": "Route Escape and the standard controller Back button to this view callback"
  },
  "Sliding panel": {
    "prefix": "transition-panel",
    "body": [
      "transition-duration: ${1:180}",
      "transition-enter: slide-from-${2:right}",
      "transition-exit: slide-to-${3:left}"
    ],
    "description": "Slide a nested panel in and out using host presentation time"
  },
  "Responsive styles": {
    "prefix": "media-phone",
    "body": [
      "@media (max-width: ${1:480})",
      "  .${2:screen}",
      "    padding: ${3:8}px"
    ],
    "description": "Insert a responsive rule inside an indented style block"
  },
  "Nine-slice background": {
    "prefix": "nine-slice",
    "body": [
      "background-image: theme.images.${1:panel}"
    ],
    "description": "Use a nine-slice image declared by theme.toml"
  },
  "Fitted image": {
    "prefix": "image-fit",
    "body": [
      "image: theme.images.${1:art}",
      "image-fit: ${2|contain,cover,stretch|}",
      "tint: ${3:#ffffffff}"
    ],
    "description": "Fit and optionally tint a foreground theme image"
  },
  "Button icon": {
    "prefix": "button-icon",
    "body": [
      "icon: theme.images.${1:icon}",
      "icon-position: ${2|start,end|}",
      "icon-size: ${3:20}",
      "icon-gap: ${4:8}",
      "tint: ${5:#ffffffff}"
    ],
    "description": "Decorate a button with a typed theme image"
  },
  "Button": {
    "prefix": "button",
    "body": [
      "<button enabled={ ${1:Enabled} } onClick={ ${2:OnClick} }>${3:Label}</button>"
    ],
    "description": "Button using declared bool and func() parameters"
  },
  "Bound label": {
    "prefix": "label",
    "body": [
      "<label>{ ${1:Title} }</label>"
    ],
    "description": "Display a declared string parameter"
  },
  "Indented styles": {
    "prefix": "style-sass",
    "body": [
      "<style>",
      "\\$space: theme.spacing.gap",
      "",
      ".${1:screen}",
      "  width: ${2:100%}",
      "  direction: column",
      "  gap: \\$space",
      "  align: stretch",
      "</style>"
    ],
    "description": "Scoped indented KartUI styles with a component variable and parent-relative width"
  },
  "Nested widget state": {
    "prefix": "state-sass",
    "body": [
      "&:${1|hover,focus,pressed,disabled|}",
      "  background: theme.colors.${2:primary-hover}"
    ],
    "description": "Nest a widget state under an indented style selector"
  },
  "Parent-relative size": {
    "prefix": "size-ui",
    "body": [
      "width: ${1:100%}",
      "height: ${2:auto}"
    ],
    "description": "Size a widget relative to its parent content area"
  },
  "SFC component": {
    "prefix": "kui",
    "body": [
      "<template>",
      "  <panel class=\"screen\">",
      "    ${1:<label>Title</label>}",
      "  </panel>",
      "</template>",
      "",
      "<style>",
      ".screen",
      "  width: 100%",
      "  padding: 16px",
      "  gap: 8px",
      "  align: stretch",
      "</style>"
    ],
    "description": "Create a compact single-file KartUI component with indented styles"
  },
  "Legacy component": {
    "prefix": "legacy-kartui",
    "body": [
      "type ${1:Menu}Props struct {",
      "    Title string",
      "}",
      "",
      "setup ${1}(props ${1}Props) {",
      "    $0",
      "}",
      "",
      "kartui ${1} {",
      "    <panel modal=\"true\" class=\"screen\">",
      "        <label>{ props.Title }</label>",
      "    </panel>",
      "}",
      "",
      "style {",
      "    .screen {",
      "        background: theme.colors.surface;",
      "        padding: theme.spacing.panel;",
      "    }",
      "}"
    ],
    "description": "Legacy KartUI component for existing projects"
  },
  "Layout class override": {
    "prefix": "style-layout",
    "body": [
      "${1:Frame}.${2:content}",
      "  ${3:gap}: ${4:12px}"
    ],
    "description": "Override a layout-owned class explicitly inside the consuming component style block"
  },
  "Checkbox": {
    "prefix": "checkbox",
    "body": [
      "<checkbox checked={${1:enabled}} onChange={func(v bool) { ${1} = v }}>${2:Enabled}</checkbox>"
    ],
    "description": "Insert checkbox with its typed bindings"
  },
  "Text input": {
    "prefix": "input",
    "body": [
      "<input value={${1:name}} onChange={func(v string) { ${1} = v }} placeholder=\"${2:Name}\"/>"
    ],
    "description": "Insert text input with its typed bindings"
  },
  "Slider": {
    "prefix": "slider",
    "body": [
      "<slider min=\"${1:0}\" max=\"${2:100}\" value={${3:volume}} onChange={func(v int32) { ${3} = v }}/>"
    ],
    "description": "Insert slider with its typed bindings"
  },
  "Combo": {
    "prefix": "combo",
    "body": [
      "<combo rows={${1:choices}} selected={${2:selected}} onChange={func(v uint32) { ${2} = v }}/>"
    ],
    "description": "Insert combo with its typed bindings"
  },
  "Tabs": {
    "prefix": "tabs",
    "body": [
      "<tabs selected={${1:active}} onChange={func(v uint32) { ${1} = v }}>",
      "  <tab title=\"${2:General}\">${3:<label>Settings</label>}</tab>",
      "  <tab title=\"${4:Video}\">${5:<label>Video settings</label>}</tab>",
      "</tabs>"
    ],
    "description": "Insert tabs with its typed bindings"
  },
  "Tooltip": {
    "prefix": "tooltip",
    "body": [
      "tooltip=\"${1:Help text}\""
    ],
    "description": "Insert a literal tooltip attribute"
  },
  "Settings screen": {
    "prefix": "settings-ui",
    "body": [
      "<script setup lang=\"go\">",
      "import engine \"example.com/game/.karty/engine\"",
      "",
      "func setup() {",
      "    audio := true",
      "    name := \"Player\"",
      "    volume := int32(50)",
      "    selected := uint32(1)",
      "    tab := uint32(0)",
      "    rows := []engine.UIRow{",
      "        {ID: 1, Text: \"Easy\", Enabled: true},",
      "        {ID: 2, Text: \"Hard\", Enabled: true},",
      "    }",
      "}",
      "</script>",
      "",
      "<template>",
      "  <panel modal=\"true\" class=\"settings\">",
      "    <checkbox checked={audio} onChange={func(v bool) { audio = v }} tooltip=\"Enable sound\">Audio</checkbox>",
      "    <input value={name} onChange={func(v string) { name = v }} placeholder=\"Player name\"/>",
      "    <slider min=\"0\" max=\"100\" value={volume} onChange={func(v int32) { volume = v }}/>",
      "    <combo rows={rows} selected={selected} onChange={func(v uint32) { selected = v }}/>",
      "    <tabs selected={tab} onChange={func(v uint32) { tab = v }}>",
      "      <tab title=\"General\"><label>General settings</label></tab>",
      "      <tab title=\"Video\"><label>Video settings</label></tab>",
      "    </tabs>",
      "  </panel>",
      "</template>",
      "",
      "<style>",
      ".settings",
      "  width: 80%",
      "  height: 80%",
      "  padding: 16px",
      "  gap: 8px",
      "  align: stretch",
      "</style>"
    ],
    "description": "Complete SFC example with checkbox, input, slider, combo, tabs and tooltips; update the engine import to your module"
  }
}
