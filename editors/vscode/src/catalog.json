  "tags": {
    "panel": {
      "detail": "Layout container. A component has one root panel. Nested panels can contain controls.",
      "attributes": [
        "class",
        "modal",
        "onBack",
        "tooltip"
      ]
    },
    "label": {
      "detail": "Text label: one literal or one Go expression, e.g. {props.Title}.",
      "attributes": [
        "class",
        "tooltip"
      ]
    },
    "image": {
      "detail": "Image control; choose a typed theme image with the image style.",
      "attributes": [
        "class",
        "tooltip"
      ]
    },
    "button": {
      "detail": "Button with onClick={func()}. Body is one literal or one Go text expression.",
      "attributes": [
        "class",
        "enabled",
        "onClick",
        "tooltip"
      ]
    },
    "list": {
      "detail": "Host-owned rows: rows={[]UIRow}, onClick={func(uint32)}.",
      "attributes": [
        "class",
        "enabled",
        "rows",
        "onClick",
        "tooltip"
      ]
    },
    "checkbox": {
      "detail": "checked={bool}, onChange={func(bool)}. Body label must be literal.",
      "attributes": [
        "class",
        "enabled",
        "checked",
        "onChange",
        "tooltip"
      ]
    },
    "input": {
      "detail": "value={string}, onChange={func(string)}. Supports literal placeholder.",
      "attributes": [
        "class",
        "enabled",
        "value",
        "onChange",
        "placeholder",
        "tooltip"
      ]
    },
    "slider": {
      "detail": "value={int32}, onChange={func(int32)}. Literal min/max; defaults 0/100.",
      "attributes": [
        "class",
        "enabled",
        "value",
        "onChange",
        "min",
        "max",
        "tooltip"
      ]
    },
    "combo": {
      "detail": "Selectable rows={[]UIRow}, selected={uint32}, onChange={func(uint32)}.",
      "attributes": [
        "class",
        "enabled",
        "rows",
        "selected",
        "onChange",
        "tooltip"
      ]
    },
    "tabs": {
      "detail": "Container of tab children: selected={uint32}, onChange={func(uint32)}.",
      "attributes": [
        "class",
        "enabled",
        "selected",
        "onChange",
        "tooltip"
      ]
    },
    "tab": {
      "detail": "Tab content container, directly inside tabs. Its title is literal.",
      "attributes": [
        "class",
        "title",
        "tooltip"
      ]
    },
    "slot": {
      "detail": "Layout projection point; default children are fallback content.",
      "attributes": [
        "name"
      ]
    },
    "fragment": {
      "detail": "Named slot fill inside a layout invocation.",
      "attributes": [
        "slot"
      ]
    }
  },
  "attributes": {
    "class": {
      "detail": "One static style class from this component. Multiple classes and dynamic classes are unsupported.",
      "insert": "class=\"${1:screen}\"",
      "values": []
    },
    "tooltip": {
      "detail": "Literal help text, up to 4096 UTF-8 bytes.",
      "insert": "tooltip=\"${1:Help text}\"",
      "values": []
    },
    "enabled": {
      "detail": "Go boolean expression controlling whether the control accepts input.",
      "insert": "enabled={${1:true}}",
      "values": []
    },
    "modal": {
      "detail": "Root panel: true captures game input; false keeps an interactive HUD. Defaults to true.",
      "insert": "modal=\"${1|true,false|}\"",
      "values": [
        "true",
        "false"
      ]
    },
    "onBack": {
      "detail": "Modal root/layout invocation: callback func() for Escape/gamepad Back.",
      "insert": "onBack={func() { ${1} }}",
      "values": []
    },
    "onClick": {
      "detail": "Button: func(); list: func(uint32) receives the stable row ID.",
      "insert": "onClick={func() { ${1} }}",
      "values": []
    },
    "rows": {
      "detail": "[]UIRow from the generated engine package. Each row needs a stable nonzero ID.",
      "insert": "rows={${1:rows}}",
      "values": []
    },
    "checked": {
      "detail": "Checkbox: Go bool expression for the model value.",
      "insert": "checked={${1:false}}",
      "values": []
    },
    "onChange": {
      "detail": "Typed model callback: checkbox func(bool), input func(string), slider func(int32), combo/tabs func(uint32). Widget changes invalidate the edited component automatically.",
      "insert": "onChange={${1:change}}",
      "values": []
    },
    "value": {
      "detail": "Input: string expression; slider: int32 expression for the current model value.",
      "insert": "value={${1:value}}",
      "values": []
    },
    "selected": {
      "detail": "Combo: stable uint32 row ID, 0 for none. Tabs: uint32 zero-based visible tab index.",
      "insert": "selected={${1:uint32(0)}}",
      "values": []
    },
    "placeholder": {
      "detail": "Input: literal placeholder, up to 4096 UTF-8 bytes.",
      "insert": "placeholder=\"${1:Player name}\"",
      "values": []
    },
    "min": {
      "detail": "Slider: literal integer in [-1000000, 1000000]. min must be less than max and value must lie within the bounds.",
      "insert": "min=\"${1:0}\"",
      "values": []
    },
    "max": {
      "detail": "Slider: literal integer in [-1000000, 1000000]. min must be less than max and value must lie within the bounds.",
      "insert": "max=\"${1:100}\"",
      "values": []
    },
    "title": {
      "detail": "Tab: literal title, up to 4096 UTF-8 bytes.",
      "insert": "title=\"${1:General}\"",
      "values": []
    },
    "name": {
      "detail": "Layout slot name. Omit for the default slot.",
      "insert": "name=\"${1:header}\"",
      "values": []
    },
    "slot": {
      "detail": "Named layout slot filled by this fragment.",
      "insert": "slot=\"${1:header}\"",
      "values": []
    },
    "props": {
      "detail": "Typed Go props expression passed to this child component.",
      "insert": "props={${1:props}}",
      "values": []
    },
    "key": {
      "detail": "Range child: stable uint32 or string key (up to 128 UTF-8 bytes). Preserves setup state when children reorder.",
      "insert": "key={${1:item.ID}}",
      "values": []
    }
  }
}
